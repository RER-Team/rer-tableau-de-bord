// RER Tableau de bord V2 - Schéma BDD
// Compatible PostgreSQL (local, Supabase, OVH)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mutuelle {
  id       String    @id @default(cuid())
  nom      String    @unique
  auteurs  Auteur[]
  articles Article[]
}

model Rubrique {
  id       String    @id @default(cuid())
  libelle  String    @unique
  articles Article[]
}

model Format {
  id              String    @id @default(cuid())
  libelle         String    @unique
  signesReference Int? // nombre de signes cible pour guidage rédacteur
  hasChapo        Boolean   @default(true)
  articles        Article[]
}

model Etat {
  id                 String              @id @default(cuid())
  slug               String              @unique // a_relire, corrige, valide, publie
  libelle            String
  ordre              Int                 @default(0)
  articles           Article[]
  articleHistoriques ArticleHistorique[]
}

model Auteur {
  id         String    @id @default(cuid())
  prenom     String
  nom        String
  email      String?
  telephone  String?
  mutuelleId String?
  mutuelle   Mutuelle? @relation(fields: [mutuelleId], references: [id])
  articles   Article[]
  users      User[]

  @@unique([prenom, nom])
}

model Article {
  id              String              @id @default(cuid())
  codeArticle     String? // ex. ART_2026-02 ...
  titre           String
  chapo           String?             @db.Text
  contenu         String              @db.Text
  contenuJson     Json?
  legendePhoto    String?             @db.Text
  creditPhoto     String?             @db.Text
  postRs          String?             @db.Text
  lienPhoto       String?
  lienGoogleDoc   String?
  nombreSignes    Int?
  dateDepot       DateTime?           @map("date_depot")
  datePublication DateTime?           @map("date_publication")
  auteurId        String
  auteur          Auteur              @relation(fields: [auteurId], references: [id])
  mutuelleId      String?
  mutuelle        Mutuelle?           @relation(fields: [mutuelleId], references: [id])
  rubriqueId      String?
  rubrique        Rubrique?           @relation(fields: [rubriqueId], references: [id])
  formatId        String?
  format          Format?             @relation(fields: [formatId], references: [id])
  etatId          String?
  etat            Etat?               @relation(fields: [etatId], references: [id])
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  historiques     ArticleHistorique[]
  blocs           ArticleBloc[]

  @@index([dateDepot])
  @@index([etatId])
  @@index([auteurId])
  @@index([mutuelleId])
  @@index([rubriqueId])
  @@index([formatId])
}

model ArticleBloc {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  ordre     Int
  type      String // chapo | paragraphe | image | legende
  contenu   String? @db.Text
  url       String?

  @@index([articleId])
  @@index([articleId, ordre])
}

model ArticleHistorique {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  etatId      String?
  etat        Etat?    @relation(fields: [etatId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  commentaire String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([articleId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?              @map("password_hash")
  avatarUrl           String?              @map("avatar_url")
  role                String               @default("auteur") // admin | relecteur | auteur | lecteur
  auteurId            String?
  auteur              Auteur?              @relation(fields: [auteurId], references: [id])
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  historiques         ArticleHistorique[]
  passwordResetTokens PasswordResetToken[]
  notificationPreference UserNotificationPreference?
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  notificationDeliveries NotificationDelivery[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
}

model UserNotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled      Boolean  @default(true) @map("email_enabled")
  inAppEnabled      Boolean  @default(true) @map("in_app_enabled")
  browserPushEnabled Boolean @default(false) @map("browser_push_enabled")
  onSubmitted       Boolean  @default(true) @map("on_submitted")
  onCorrections     Boolean  @default(true) @map("on_corrections")
  onPublished       Boolean  @default(true) @map("on_published")
  onAuthorActions   Boolean  @default(true) @map("on_author_actions")
  onOwnArticles     Boolean  @default(true) @map("on_own_articles")
  emailOwnArticles  Boolean  @default(true) @map("email_own_articles")
  emailAuthorActions Boolean @default(true) @map("email_author_actions")
  inAppOwnArticles  Boolean  @default(true) @map("in_app_own_articles")
  inAppAuthorActions Boolean @default(true) @map("in_app_author_actions")
  browserPushOwnArticles Boolean @default(false) @map("browser_push_own_articles")
  browserPushAuthorActions Boolean @default(false) @map("browser_push_author_actions")
  onSubmittedOwnArticles Boolean @default(true) @map("on_submitted_own_articles")
  onSubmittedAuthorActions Boolean @default(true) @map("on_submitted_author_actions")
  onCorrectionsOwnArticles Boolean @default(true) @map("on_corrections_own_articles")
  onCorrectionsAuthorActions Boolean @default(true) @map("on_corrections_author_actions")
  onPublishedOwnArticles Boolean @default(true) @map("on_published_own_articles")
  onPublishedAuthorActions Boolean @default(true) @map("on_published_author_actions")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String   @db.Text
  metadata   Json?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
}

model NotificationDelivery {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId    String?  @map("article_id")
  eventType    String   @map("event_type")
  channel      String
  dedupeKey    String   @unique @map("dedupe_key")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, eventType])
}

model NotificationTemplate {
  id           String   @id @default(cuid())
  eventType    String   @unique @map("event_type")
  emailSubject String   @map("email_subject")
  emailText    String   @map("email_text") @db.Text
  emailHtml    String   @map("email_html") @db.Text
  inAppTitle   String   @map("in_app_title")
  inAppBody    String   @map("in_app_body") @db.Text
  pushTitle    String   @map("push_title")
  pushBody     String   @map("push_body") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
}
